{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GDB-Debugger",
            "type": "cppdbg",
            "request": "launch",
            "cwd":  "${env:PROJECT_ROOT}/build/",
            "program": "${env:PROJECT_ROOT}/build/zephyr/zephyr.elf",
            "miDebuggerPath": "${env:ZEPHYR_SDK_ROOT}/xtensa-espressif_${env:ESP_VARIANT}_zephyr-elf/bin/xtensa-espressif_${env:ESP_VARIANT}_zephyr-elf-gdb",
            "setupCommands": [
                {"text": "set remotetimeout 30"},
                {"text": "target extended-remote 127.0.0.1:3333"},
                {"text": "set remote hardware-breakpoint-limit 2"},
                {"text": "set remote hardware-watchpoint-limit 2"},
                {"text": "monitor reset halt"},
                {"text": "flushregs"},
                {"text": "set mem inaccessible-by-default off"},
                {"text": "set breakpoint auto-hw on"},
                {"description": "Pretty print for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true}
            ]
        }
    ]
}
