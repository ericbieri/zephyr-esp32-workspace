{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OpenOCD-ESP32-S3",
            "type": "node-terminal",
            "request": "launch",
            "command": "\"${env:OPENOCD_ESP32_ROOT}/bin/openocd\" -s \"${env:OPENOCD_ESP32_ROOT}/share/openocd/scripts\" -f \"openocd/openocd-esp32s3-zephyr.cfg\"",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "GDB-ESP32-S3",
            "type": "cppdbg",
            "request": "launch",
            "cwd":  "${env:PROJECT_ROOT}/build/",
            "program": "${env:PROJECT_ROOT}/build/zephyr/zephyr.elf",
            "miDebuggerPath": "${env:ZEPHYR_SDK_ROOT}/xtensa-espressif_esp32s3_zephyr-elf/bin/xtensa-espressif_esp32s3_zephyr-elf-gdb",
            "setupCommands": [
                {"text": "set remotetimeout 30"},
                {"text": "target extended-remote 127.0.0.1:3333"},
                {"text": "set remote hardware-breakpoint-limit 2"},
                {"text": "set remote hardware-watchpoint-limit 2"},
                {"text": "monitor reset halt"},
                {"text": "flushregs"},
                {"text": "set mem inaccessible-by-default off"},
                {"text": "set breakpoint auto-hw on"},
                {"description": "Pretty print for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true}
            ]
        },
        {
            "preLaunchTask": "OpenOCD - ESP32 - PIO",
            "name": "ESP32 Debug - PIO",
            "type": "cppdbg",
            "request": "launch",
            "cwd":  "${env:PROJECT_ROOT}/build/",
            "program": "${env:PROJECT_ROOT}/build/zephyr/zephyr.elf",
            "miDebuggerPath": "${env:ZEPHYR_SDK_ROOT}/xtensa-espressif_esp32_zephyr-elf/bin/xtensa-espressif_esp32_zephyr-elf-gdb",
            "setupCommands": [
                {"text": "set remotetimeout 30"},
                {"text": "target extended-remote 127.0.0.1:3333"},
                {"text": "set remote hardware-breakpoint-limit 2"},
                {"text": "set remote hardware-watchpoint-limit 2"},
                {"text": "monitor reset halt"},
                // {"text": "monitor esp appimage_offset 0x10000"},
                {"text": "flushregs"},
                // {"text": "set mem inaccessible-by-default off"},
                // {"text": "set breakpoint auto-hw on"},
                // {"text": "thbreak setup"},
                // {"text": "continue"},
                {"description": "Pretty print for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true}
            ]
        }
    ]
}
