{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OpenOCD-ESP32",
      "type": "shell",
      "command": "${env:OPENOCD_ESP32_ROOT}/bin/openocd",
      "args": [
        "-s",
        "${env:OPENOCD_ESP32_ROOT}/share/openocd/scripts",
        "-f",
        "openocd/openocd-${config:esp32.variant}-zephyr.cfg"
      ],
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(?!)"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Listening on port 3333 for gdb connections"
        }
      }
    },
    {
      "label": "OpenOCD ESP32 - Upload",
      "type": "shell",
      "command": "${env:OPENOCD_ESP32_ROOT}/bin/openocd",
      "args": [
        "-s",
        "${env:OPENOCD_ESP32_ROOT}/share/openocd/scripts",
        "-f",
        "interface/ftdi/esp_ftdi.cfg",
        "-f",
        "target/esp32.cfg",
        "-c",
        "adapter speed 20000",
        "-c",
        "init; halt; program_esp ${config:project.root}/build/zephyr/zephyr.bin 0x10000 verify reset exit"
      ],
      "isBackground": false,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "OpenOCD ESP32S3 - Upload",
      "type": "shell",
      "command": "${env:OPENOCD_ESP32_ROOT}/bin/openocd",
      "args": [
        "-s",
        "${env:OPENOCD_ESP32_ROOT}/share/openocd/scripts",
        "-f",
        "board/${config:esp32.variant}-builtin.cfg",
        "-c",
        "adapter speed 20000",
        "-c",
        "init; halt; program_esp ${config:project.root}/build/zephyr/zephyr.bin 0x10000 verify reset exit"
      ],
      "isBackground": false,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "GDB - ESP32",
      "type": "shell",
      "command": "${env:ZEPHYR_SDK_ROOT}/xtensa-espressif_esp32_zephyr-elf/bin/xtensa-espressif_esp32_zephyr-elf-gdb",
      "args": [
        "${config:project.root}/build/zephyr/zephyr.elf"
      ],
      "isBackground": false,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "options": {
        "cwd": "${config:project.root}/build/"
      },
      "problemMatcher": []
    },
    {
      "label": "GDB - ESP32S3",
      "type": "shell",
      "command": "${env:ZEPHYR_SDK_ROOT}/xtensa-espressif_${config:esp32.variant}_zephyr-elf/bin/xtensa-espressif_${config:esp32.variant}_zephyr-elf-gdb",
      "args": [
        "${config:project.root}/build/zephyr/zephyr.elf"
      ],
      "isBackground": false,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "options": {
        "cwd": "${config:project.root}/build/"
      },
      "problemMatcher": []
    }
  ]
}
