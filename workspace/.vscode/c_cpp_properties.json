{
    "configurations": [
        {
            "name": "Zephyr Dev Container",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/**"
                ],
                "limitSymbolsToIncludedHeaders": true
            },
            "cStandard": "c11",
            "cppStandard": "c++11",
            "intelliSenseMode": "linux-clang-x64",
            "compileCommands": [
                "${config:project.root}/build/compile_commands.json"
            ]
        }
    ],
    "version": 4
}