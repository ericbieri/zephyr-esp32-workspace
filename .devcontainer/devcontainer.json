{
  "name": "Zephyr development environment for ESP32 Xtensa MCUs",
  "image": "erichbieri/devcontainer-zephyr-esp32-xtensa:0.0.47",
  // Use this Dockerfile if you are within the Swiss Post network
  // "build": {
  //   "dockerfile": "Dockerfile.swiss-post",
  //   "context": "."
  // },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "nordic-semiconductor.nrf-devicetree",
        "ms-vscode.hexeditor",
        "github.copilot"
      ]
    }
  },
  "forwardPorts": [],
  "workspaceMount": "source=${localWorkspaceFolder}/workspace/applications,target=/workspace/applications,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  // "postStartCommand": "code --file-uri /zephyr.code-workspace", // Does not work
  "mounts": [
    "source=/dev/bus/usb,target=/dev/bus/usb,type=bind",
    "source=${localWorkspaceFolder}/workspace/.vscode,target=/workspace/.vscode,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/workspace/.west,target=/workspace/.west,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/workspace/manifest,target=/workspace/manifest,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/workspace/repos,target=/workspace/repos,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/workspace/openocd,target=/workspace/openocd,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/workspace/doc,target=/workspace/doc,type=bind,consistency=cached",
    "source=/sys/bus/usb,target=/sys/bus/usb,type=bind"
  ],
  "runArgs": [
    "--name","devcontainer-zephyr-esp32-xtensa",
    "--add-host=host.docker.internal:host-gateway", // Required if "dns" is set in the Docker Desktop settings
    // "--rm",
    "-it",
    "--privileged", // Works only on Linux hosts! Not recommended for security reasons.
    "--pid=host"
    // "--device=/dev/ttyACM0", // map specific serial devices to docker container
    // "--device=/dev/ttyACM1"
  ],
  "remoteUser": "root"
}