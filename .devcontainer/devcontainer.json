{
  "name": "Zephyr development environment for ESP32 Xtensa MCUs",
  "build": {
    "dockerfile": "erichbieri/devcontainer-zephyr-esp32-xtensa:0.0.38"
    // "dockerfile": "Dockerfile.swiss-post"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "nordic-semiconductor.nrf-devicetree",
        "ms-vscode.hexeditor",
        "github.copilot"
      ]
    }
  },
  "forwardPorts": [],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  // "postStartCommand": "code --file-uri /zephyr.code-workspace", // Does not work
  // "mounts": [
  //   "source=/dev/bus/usb,target=/dev/bus/usb,type=bind",
  //   "source=/sys/bus/usb,target=/sys/bus/usb,type=bind"
  // ],
  "runArgs": [
    "--name","devcontainer-zephyr-esp32-xtensa-main",
    "--add-host=host.docker.internal:host-gateway", // Required if "dns" is set in the Docker Desktop settings
    // "--rm",
    "-it",
    //"--privileged", // Works only on Linux hosts! Not recommended for security reasons.
    "--pid=host"
    // "--device","/dev/ttyUSB0", // map specific serial devices to docker container
    // "--device","/dev/ttyACM0"
  ],
  "remoteUser": "root"
}