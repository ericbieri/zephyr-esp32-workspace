{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OpenOCD - ESP32-S3",
      "type": "shell",
      "command": "/opt/toolchains/debug/openocd-esp32/bin/openocd",
      "args": [
        "-s","/opt/toolchains/debug/openocd-esp32/share/openocd/scripts",
        "-c","set ESP_RTOS none",
        "-c","adapter speed 20000",
        "-c","transport select jtag",
        "-f","board/esp32s3-builtin.cfg",
        "-c","tcl port 6666",
        "-c","telnet port 4444",
        "-c","gdb port 3333"
      ],
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "OpenOCD - ESP32 - PIO",
      "type": "shell",
      "command": "/opt/toolchains/debug/openocd-esp32/bin/openocd",
      "args": [
        "-s", "/opt/toolchains/debug/openocd-esp32/share/openocd/scripts",
        "-c","set ESP_RTOS none",
        "-f","interface/ftdi/esp_ftdi.cfg",
        "-f","target/esp32.cfg",
        "-c","adapter speed 5000",
        // "-c","tcl port 6666",
        // "-c","telnet port 4444",
        // "-c","gdb port 3333",
        // "-f","/opt/toolchains/debug/openocd-esp32/share/openocd/scripts/board/esp32-builtin.cfg",
        "-c","init",
        "-c","reset halt",
        // Disable RTC WDT
        // "-c","mww 0x3FF480A4 0x50D83AA1",
        // "-c","mww 0x3FF4808C 0x00000000",
        // "-c","mww 0x3FF480A4 0x00000000",
        // // Disable TIMG0 WDT
        // "-c","mww 0x3FF5F064 0x50D83AA1",
        // "-c","mww 0x3FF5F048 0x00000000",
        // "-c","mww 0x3FF5F064 0x00000000",
        // // Disable TIMG1 WDT
        // "-c","mww 0x3FF60064 0x50D83AA1",
        // "-c","mww 0x3FF60048 0x00000000",
        // "-c","mww 0x3FF60064 0x00000000",
        // // Disable Super WDT
        // "-c","mww 0x3FF480AC 0x8F1D312A",
        // "-c","mww 0x3FF480A8 0x80000000",
        // "-c","mww 0x3FF480AC 0x00000000"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": ".*Listening on port 3333 for gdb connections.*"
        }
      },
      "presentation": { 
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "OpenOCD - ESP32S3 - PIO",
      "type": "shell",
      "command": "/opt/toolchains/debug/openocd-esp32/bin/openocd",
      "args": [
        "-s", "/opt/toolchains/debug/openocd-esp32s3/share/openocd/scripts",
        "-c","set ESP_RTOS none",
        "-f","board/esp32s3-builtin.cfg",
        "-c","adapter speed 5000",
        "-c","init",
        "-c","reset halt"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": ".*Listening on port 3333 for gdb connections.*"
        }
      },
      "presentation": { 
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "OpenOCD ESP32 - Upload",
      "type": "shell",
      "command": "/opt/toolchains/debug/openocd-esp32/bin/openocd",
      "args": [
        "-s","/opt/toolchains/debug/openocd-esp32/share/openocd/scripts",
        "-f", "interface/ftdi/esp_ftdi.cfg",
        "-f", "target/esp32.cfg",
        "-c", "adapter speed 20000",
        "-c", "init; halt; program_esp /workspace/01_blink/build/zephyr/zephyr.bin 0x10000 verify reset exit"
      ],
      "isBackground": false,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "OpenOCD ESP32S3 - Upload",
      "type": "shell",
      "command": "/opt/toolchains/debug/openocd-esp32/bin/openocd",
      "args": [
        "-s","/opt/toolchains/debug/openocd-esp32/share/openocd/scripts",
        "-f","board/esp32s3-builtin.cfg",
        "-c", "adapter speed 20000",
        "-c", "init; halt; program_esp /workspace/01_blink/build/zephyr/zephyr.bin 0x10000 verify reset exit"
      ],
      "isBackground": false,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "GDB - ESP32",
      "type": "shell",
      "command": "/opt/toolchains/zephyr-sdk-0.17.4/xtensa-espressif_esp32_zephyr-elf/bin/xtensa-espressif_esp32_zephyr-elf-gdb",
      "args": [
        // "-q",
        // "-l 10",
        // "--interpreter=mi2",
        // "--data-directory /opt/toolchains/zephyr-sdk-0.17.4/xtensa-espressif_esp32_zephyr-elf/share/gdb",
        // "-x", "${workspaceFolder}/scripts/gdb/esp32-disable-wdt.gdb",
        "${workspaceFolder}/01_blink/build/zephyr/zephyr.elf"
      ],
      "isBackground": false,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}/01_blink/build/"
      },
      "problemMatcher": []
    },
    {
      "label": "GDB - ESP32S3",
      "type": "shell",
      "command": "/opt/toolchains/zephyr-sdk-0.17.4/xtensa-espressif_esp32s3_zephyr-elf/bin/xtensa-espressif_esp32s3_zephyr-elf-gdb",
      "args": [
        // "-q",
        // "-l 10",
        // "--interpreter=mi2",
        // "--data-directory /opt/toolchains/zephyr-sdk-0.17.4/xtensa-espressif_esp32s3_zephyr-elf/share/gdb",
        // "-x", "${workspaceFolder}/scripts/gdb/esp32-disable-wdt.gdb",
        "${workspaceFolder}/01_blink/build/zephyr/zephyr.elf"
      ],
      "isBackground": false,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}/01_blink/build/"
      },
      "problemMatcher": []
    }
  ]
}
